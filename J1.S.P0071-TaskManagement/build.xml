<?xml version="1.0" encoding="UTF-8"?>
<project name="TaskManagement" default="jar" basedir=".">
    <property file="nbproject/project.properties"/>
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
    </target>
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" release="21"
               encoding="${source.encoding}" includeantruntime="false"/>
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}" manifest="${manifest.file}">
            <manifest><attribute name="Main-Class" value="${main.class}"/></manifest>
        </jar>
    </target>
    <target name="run" depends="compile">
        <java classname="${main.class}" fork="true" classpath="${build.classes.dir}"/>
    </target>
    <target name="test" depends="compile">
        <mkdir dir="${build.test.classes.dir}"/>
        <javac srcdir="${test.src.dir}" destdir="${build.test.classes.dir}" release="21"
               encoding="${source.encoding}" includeantruntime="false" classpath="${build.classes.dir}"/>
        <java classname="TaskManagementTest" fork="true" failonerror="true">
            <classpath><pathelement path="${build.classes.dir}"/><pathelement path="${build.test.classes.dir}"/></classpath>
        </java>
    </target>
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
